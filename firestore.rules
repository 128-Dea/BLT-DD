rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasAdminEmail() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('.*@admin\\.com$');
    }

    function hasKadesEmail() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email.matches('.*@kades\\.com$');
    }

    function hasRole(role) {
      return isSignedIn() && (
        (hasUserDoc() && currentUser().role == role) ||
        (role == 'perangkat_desa' && hasAdminEmail()) ||
        (role == 'kepala_desa' && hasKadesEmail())
      );
    }

    function isPerangkatDesa() {
      return hasRole('perangkat_desa');
    }

    function isKepalaDesa() {
      return hasRole('kepala_desa');
    }

    function isOwner() {
      return resource.data.ownerUid == request.auth.uid;
    }

    function isCreatingOwnData() {
      return request.resource.data.ownerUid == request.auth.uid;
    }

    function approvalOnlyChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'statusApproval',
        'statusApprovalAt',
        'firebaseSyncStatus',
      ]);
    }

    function approvalFieldsUnchanged() {
      return request.resource.data.statusApproval == resource.data.statusApproval &&
        (
          (!('statusApprovalAt' in resource.data) && !('statusApprovalAt' in request.resource.data)) ||
          request.resource.data.statusApprovalAt == resource.data.statusApprovalAt
        );
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /dataWarga/{docId} {
      allow read: if isSignedIn() && (isKepalaDesa() || isOwner());

      allow create: if isPerangkatDesa() && isCreatingOwnData();

      allow update: if isSignedIn() && (
        (isPerangkatDesa() &&
          isOwner() &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          approvalFieldsUnchanged()) ||
        (isKepalaDesa() && approvalOnlyChanged())
      );

      allow delete: if isSignedIn() && (isKepalaDesa() || isOwner());
    }
  }
}
