rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && currentUser().role == role;
    }

    function isPerangkatDesa() {
      return hasRole('perangkat_desa');
    }

    function isKepalaDesa() {
      return hasRole('kepala_desa');
    }

    function isOwner() {
      return resource.data.ownerUid == request.auth.uid;
    }

    function isCreatingOwnData() {
      return request.resource.data.ownerUid == request.auth.uid;
    }

    function approvalOnlyChanged() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly([
        'statusApproval',
        'statusApprovalAt',
        'firebaseSyncStatus',
      ]);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /dataWarga/{docId} {
      allow read: if isSignedIn() && (isKepalaDesa() || isOwner());

      allow create: if isPerangkatDesa() && isCreatingOwnData();

      allow update: if isSignedIn() && (
        (isPerangkatDesa() &&
          isOwner() &&
          request.resource.data.ownerUid == resource.data.ownerUid &&
          request.resource.data.statusApproval == resource.data.statusApproval &&
          request.resource.data.statusApprovalAt == resource.data.statusApprovalAt) ||
        (isKepalaDesa() && approvalOnlyChanged())
      );

      allow delete: if isSignedIn() && (isKepalaDesa() || isOwner());
    }
  }
}
